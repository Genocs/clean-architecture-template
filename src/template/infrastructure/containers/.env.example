# This file is a template for the .env file that is used by the docker-compose.yml file.
# Copy to ./.env and fill in real values before starting the stack.

# Database credentials
MSSQL_PASSWORD=<<SA_PASSWORD>>
POSTGRES_PASSWORD=<<POSTGRES_PASSWORD>>
HASHICORP_TOKEN=<<HASHICORP_TOKEN>>
ORACLE_PASSWORD=<<ORACLE_PWD>>
MYSQL_ROOT_PASSWORD=<<MYSQL_ROOT_PASSWORD>>

# Seq (logs)
SEQ_FIRSTRUN_ADMINPASSWORD=<<SEQ_FIRSTRUN_ADMINPASSWORD>>

# Grafana - if either is unset the compose file falls back to admin/admin (dev only).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<<GRAFANA_ADMIN_PASSWORD>>

# Genocs apps
MONGO_DB_CONNECTION_STRING=<<MONGO_DB_CONNECTION_STRING>>
CONSUL_URL=http://consul
FABIO_URL=http://fabio
SEQ_URL=http://seq
SEQ_APIKEY=<<SEQ_API_KEY>>

# OTLP collector endpoint consumed by the apps as telemetry.exporter.otlpEndpoint.
# Default: Jaeger all-in-one.
# To use the Aspire Dashboard instead, start the monitoring stack with --profile aspire
# and set: OTLP_URL=http://aspire_dashboard:18889
OTLP_URL=http://jaeger
