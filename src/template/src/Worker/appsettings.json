{
  "Logging": {
    "IncludeScopes": false,
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Error"
      }
    },
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Debug",
      "Microsoft": "Debug",
      "Microsoft.Hosting.Lifetime": "Debug"
    }
  },
  "ConnectionStrings": {
    "ApplicationInsights": "",
    "AzureServiceBus": ""
  },
  "AppSettings": {
    "ServiceName": "Demo-Worker"
  },
  "TopicSettings": {
    "ConnectionString": "Endpoint=sb://xxx.servicebus.windows.net/;SharedAccessKeyName=RMQ-xxxx;SharedAccessKey=xxxx",
    "TopicName": "topic-name",
    "SubscriptionName": "subscription-name"
  },
  "QueueSettings": {
    "ConnectionString": "Endpoint=sb://xxx.servicebus.windows.net/;SharedAccessKeyName=RMQ-xxxx;SharedAccessKey=xxxx",
    "QueueName": "queue-name"
  },
  "mongodb": {
    "connectionString": "mongodb://localhost:27017",
    "database": "demo",
    "enableTracing": true
  },
  "app": {
    "name": "Demo Worker",
    "service": "demo-worker-service",
    "instance": "000001",
    "version": "v1.0",
    "displayBanner": true,
    "displayVersion": true
  },
  "logger": {
    "level": "information",
    "excludePaths": [
      "/",
      "/ping",
      "/metrics"
    ],
    "excludeProperties": [
      "api_key",
      "access_key",
      "ApiKey",
      "ApiSecret",
      "ClientId",
      "ClientSecret",
      "ConnectionString",
      "Password",
      "Email",
      "Login",
      "Secret",
      "Token"
    ],
    "console": {
      "enabled": true
    },
    "file": {
      "enabled": true,
      "path": "logs/logs.txt",
      "interval": "day"
    }
  },
  "rabbitMq": {
    "connectionName": "users-service",
    "retries": 3,
    "retryInterval": 2,
    "conventionsCasing": "snakeCase",
    "logger": {
      "enabled": true
    },
    "username": "guest",
    "password": "guest",
    "virtualHost": "/",
    "port": 5672,
    "hostnames": [
      "localhost"
    ],
    "requestedConnectionTimeout": "00:00:30",
    "requestedHeartbeat": "00:01:00",
    "socketReadTimeout": "00:00:30",
    "socketWriteTimeout": "00:00:30",
    "continuationTimeout": "00:00:20",
    "handshakeContinuationTimeout": "00:00:10",
    "networkRecoveryInterval": "00:00:05",
    "exchange": {
      "declare": true,
      "durable": true,
      "autoDelete": false,
      "type": "topic",
      "name": "users"
    },
    "queue": {
      "declare": true,
      "durable": true,
      "exclusive": false,
      "autoDelete": false,
      "template": "users-service/{{exchange}}.{{message}}"
    },
    "context": {
      "enabled": true,
      "header": "message_context"
    },
    "spanContextHeader": "span_context"
  },
  "swagger": {
    "enabled": true,
    "reDocEnabled": false,
    "name": "v1",
    "title": "API",
    "version": "v1",
    "routePrefix": "swagger",
    "includeSecurity": true
  },
  "security": {
    "certificate": {
      "header": "Certificate"
    }
  },
  "ApplicationInsights": {
    "DeveloperMode": false
  },
  "Serilog": {
    "MinimumLevel": "Verbose",
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "RollingFile",
        "Args": {
          "pathFormat": "Logs/deliveryservice-{Date}.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "retainedFileCountLimit": 10
        }
      }
    ]
  },
  "ExternalWebServices": {
    "Order": "https://www.genocs/orders",
    "Basket": "https://www.genocs/basket"
  },
  "ServiceRequestOptions": {
    "MaxRetries": 5,
    "CircuitBreakerThreshold": 1,
    "MaxBulkheadSize": 1,
    "MaxBulkheadQueueSize": 1,
    "CircuitBreakerSamplingPeriodSeconds": 50,
    "CircuitBreakerMinimumThroughput": 100,
    "CircuitBreakerBreakDurationSeconds": 10
  },
  "SERVICE_URI_SIMPLE": "https://localhost:5001",
  "SERVICE_URI_AUTHORIZED": "https://localhost:5010",
  "RebusBusSettings": {
    "TransportConnection": "amqp://guest:guest@localhost:5672/",
    "QueueName": "mybeautiful-queue"
  },
  "AzureServiceBusSettings": {
    "QueueEndpoint": "my.servicebus.windows.net",
    "QueueName": "mybeautiful-queue",
    "QueueAccessPolicyName": "policyAccessName",
    "QueueAccessPolicyKey": "policyAccessKey",
    "MaxConcurrency": 20,
    "PrefetchCount": 3000
  },
  "NServiceBus": {
    "EndpointName": "Worker",
    "UsePersistence": true,
    "TransportConnectionString": "host=localhost;username=guest;password=guest",
    "PersistenceConnectionString": "mongodb://localhost",
    "PersistenceDatabase": "ParticularPersistence"
  },
  "MassTransitSettings": {
    "HostName": "localhost",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  }
}
