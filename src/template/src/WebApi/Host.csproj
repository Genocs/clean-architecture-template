<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Genocs.CleanArchitecture.Template.WebApi</RootNamespace>
        <AssemblyName>Genocs.CleanArchitecture.Template.WebApi</AssemblyName>
        <IsPackable>false</IsPackable>
        <UserSecretsId>Genocs</UserSecretsId>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <DockerfileContext>..\..</DockerfileContext>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <DocumentationFile>api-documentation.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DefineConstants>TRACE;__Full__</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
        <PackageReference Include="AspNetCore.HealthChecks.MongoDb" Version="9.0.0" />
        <PackageReference Include="EPPlus" Version="8.5.4" />
        <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
        <PackageReference Include="Refit.HttpClientFactory" Version="10.1.6" />
        <PackageReference Include="Microsoft.FeatureManagement.AspNetCore" Version="4.4.0" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Genocs.Logging" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.Telemetry" Version="9.0.0-beta008" />
        <PackageReference Include="Genocs.WebApi.OpenApi" Version="9.0.0-beta008" />
    </ItemGroup>    

    <ItemGroup>
        <ProjectReference Include="..\Domain\Domain.csproj" />
        <ProjectReference Include="..\Application\Application.csproj" />
        <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

<!--#if (NServiceBus) -->
    <ItemGroup>
        <ProjectReference Include="..\Contracts.NServiceBus\Contracts.NServiceBus.csproj" />

        <None Update="License.xml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
<!--#endif -->

</Project>