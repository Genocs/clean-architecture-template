{
  "app": {
    "name": "WebApi",
    "service": "webapi",
    "instance": "1",
    "version": "v1.0",
    "displayBanner": true,
    "displayVersion": true
  },
  "logger": {
    "level": "debug",
    "excludePaths": [
      "/",
      "/healthz",
      "/alive",
      "/metrics"
    ],
    "excludeProperties": [
      "api_key",
      "access_key",
      "ApiKey",
      "ApiSecret",
      "ClientId",
      "ClientSecret",
      "ConnectionString",
      "Password",
      "Email",
      "Login",
      "Secret",
      "Token"
    ],
    "console": {
      "enabled": true,
      "enableTracing": true
    },
    "file": {
      "enabled": true,
      "path": "logs/logs.txt",
      "interval": "day"
    },
    "tags": {}
  },
  "rabbitMQ": {
    "HostName": "localhost",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "mongoDb": {
    "connectionString": "mongodb://localhost:27017",
    "database": "webapi-service",
    "enableTracing": true,
    "seed": false
  },
  "databaseSettings": {
    "DBProvider": "mongodb",
    "ConnectionString": "mongodb://localhost:27017"
  },
  "AllowedHosts": "*",
  "ExternalWebServices": {
    "Order": "https://www.genocs/orders",
    "Basket": "https://www.genocs/basket"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;User Id=sa;Password=Password01!;Database=default"
  },
  "MongoSettings": {
    "Connection": "mongodb://localhost:27017",
    "DatabaseName": "microservice"
  },
  "RebusBusSettings": {
    "TransportConnection": "amqp://guest:guest@localhost:5672/",
    "QueueName": "rebus-queue"
  },
  "FeatureManagement": {
    "Transfer": true,
    "GetAccountDetailsV2": true
  },
  "AzureServiceBusSettings": {
    "QueueEndpoint": "test",
    "QueueName": "queue"
  },
  "NServiceBus": {
    "EndpointName": "Worker",
    "UsePersistence": true,
    "TransportConnectionString": "host=localhost;username=guest;password=guest",
    "PersistenceConnectionString": "mongodb://localhost",
    "PersistenceDatabase": "ParticularPersistence"
  },
  "MassTransitSettings": {
    "HostName": "localhost",
    "VirtualHost": "/",
    "UserName": "guest",
    "Password": "guest"
  },
  "EPPlus": {
    "ExcelPackage": {
      "License": "NonCommercialOrganization:Genocs"
    }
  }
}