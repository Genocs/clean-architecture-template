          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();\r",
                  "pm.collectionVariables.set(\"token\", jsonData.token);\r",
                  "pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);\r",
                  "\r",
                  "pm.test(\"Response time is less than 200ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(400);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Successful POST request\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);\r",
                  "});\r",
                  "\r",
                  "var schema = {\r",
                  "    \"items\": {\r",
                  "        \"token\": \"string\",\r",
                  "        \"refreshToken\": \"string\",\r",
                  "        \"refreshTokenExpiryTime\": \"datetime\"\r",
                  "    }\r",
                  "};\r",
                  "\r",
                  "var data1 = [true, true, true];\r",
                  "\r",
                  "pm.test('Schema is valid', function () {\r",
                  "    pm.expect(tv4.validate(data1, schema)).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function getRandom10DigitNumber() {\r",
                  "    // From 1000000000 to 9999999999 (inclusive)\r",
                  "    const min = 1000000000;\r",
                  "    const max = 9999999999;\r",
                  "    return Math.floor(Math.random() * (max - min + 1)) + min;\r",
                  "}\r",
                  "\r",
                  "// Example: set it as a variable\r",
                  "const random10Digits = getRandom10DigitNumber();\r",
                  "pm.variables.set(\"random10Digits\", random10Digits.toString());"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"ssn\": \"{{random10Digits}}\",\r\n    \"name\": \"{{$randomFullName}}\",\r\n    \"initialAmount\": 1000\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{root_url}}/v1/Customers",
              "host": [
                "{{root_url}}"
              ],
              "path": [
                "v1",
                "Customers"
              ]
            }
          },
          "response": []
        }
